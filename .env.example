# ============================================================
# 电子图说 · 语音布置清单 —— 配置文件
# 复制一份改名成 .env 再改：cp .env.example .env
# 改完需要重启服务（Ctrl+C 后 npm start）
# 真实的 .env 不会进 git
# ============================================================

# ---------- 服务 ----------
PORT=3210
HOST=127.0.0.1

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# 数据与导出目录（默认在工作区目录下，工作区默认为启动时的当前目录）
# 工作区：数据与导出文件的根目录。可用三种方式指定，优先级从高到低：
#   1) 命令行参数：node server/index.js --workdir /path/to/workspace
#   2) 环境变量：WORK_DIR（也可写成 WORKDIR）
#   3) 默认：启动时的当前目录（process.cwd()）
# WORK_DIR=/path/to/workspace

# 数据与导出子目录（相对于 WORK_DIR，也可给绝对路径）
# DATA_DIR=data
# EXPORTS_DIR=exports

# ---------- AI：生成"描述"的模型 ----------
# 可选：ollama | lmstudio | deepseek | openai | custom
# 选预设后，下面的 LLM_BASE_URL / LLM_MODEL 都可以不填
LLM_PROVIDER=ollama

# 想换成 DeepSeek，改成：
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-xxxxxxxx

# 手动覆盖地址与模型（留空则用 LLM_PROVIDER 的默认值）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b

# 密钥：如果不想写在 LLM_API_KEY，也可以用服务商专属变量
# LLM_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 请求超时（毫秒）
# LLM_TIMEOUT_MS=90000

# Ollama 的思考模式开关：none 更快；想让它先思考可设为 medium / high
# LLM_REASONING_EFFORT=none

# ---------- 语音转文字（本机 mlx-whisper） ----------
# WHISPER_BIN=$HOME/.local/bin/mlx_whisper
# WHISPER_MODEL 支持两种写法：
#   1) HuggingFace 仓库名（首次转写会自动下载）：
#      WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
#   2) 本地模型目录（已用 hf/ModelScope 下载好后直接指向它，不再联网）：
#      WHISPER_MODEL=/Users/you/models/whisper-large-v3-turbo-mlx
# WHISPER_LANGUAGE=zh
# 单次转写超时（毫秒）。首次下载 1.6GB 模型可能超过 5 分钟，默认 15 分钟
# WHISPER_TIMEOUT_MS=900000

# ---------- 导出视频（图片幻灯 + 语音 + 文案字幕，合成 mp4） ----------
# 竖屏 1080×1920，微信聊天/朋友圈友好
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
# VIDEO_FPS=25
# 没有语音的条目：每张图显示几秒
# VIDEO_SECONDS_PER_IMAGE=2
# 多图条目每张图之间的横向滑动过渡秒数（画册式左右切换）
# VIDEO_TRANS_SECONDS=0.5
# 是否把文案烧成底部字幕（默认开启；本机找不到中文字体时字幕会留空）
# VIDEO_BURN_TEXT=1
# 字幕字体族（留空用内置默认，覆盖 macOS / Windows / Linux 常见中文字体）
# VIDEO_FONT_FAMILY=PingFang SC, Songti SC, STHeiti, Microsoft YaHei, Noto Sans CJK SC, sans-serif
# 视频语音来源：auto（有录音用录音，无录音用 macOS TTS 读文案）/ recording（只用录音）/ tts（只用 TTS）
# VIDEO_AUDIO_SOURCE=auto
# macOS 系统 TTS 语音名（say -v 名称）。列出可用语音：say -v '?'（中文有 Tingting/Meijia/Sinji 等）
# VIDEO_TTS_VOICE=Tingting

# ---------- 外部可执行文件（一般不用改，启动时会自动探测） ----------
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# SAY_PATH=/usr/bin/say
